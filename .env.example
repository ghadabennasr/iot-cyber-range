# Copy to .env (git-ignored). Required for the dashboard "Queue block" button.
DASHBOARD_TOKEN=replace-with-a-long-random-string

# --- Application backend (Backend/) ---
# Use letters/digits only for passwords you also put in the broker (Broker/add-user.ps1).
POSTGRES_PASSWORD=replace-with-a-long-random-string
# Broker passwords of the `backend` (read-only) and `controller` (lock commands) accounts.
BACKEND_MQTT_PASSWORD=
CONTROLLER_MQTT_PASSWORD=
# Bearer token for POST /api/lock/command and POST /api/badges.
API_TOKEN=replace-with-a-long-random-string
